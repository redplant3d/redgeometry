{
    "compilerOptions": {
        "declaration": true,
        "erasableSyntaxOnly": true,
        "esModuleInterop": true,
        "isolatedDeclarations": true,
        "isolatedModules": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "strict": true,
        "target": "ESNext",
        "verbatimModuleSyntax": true
    }
}
